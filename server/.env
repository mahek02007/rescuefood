# Server configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# For local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodrescue?schema=public"
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# For Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require

# JWT Authentication
JWT_SECRET="foodrescue_jwt_secret_key_production_ready_2026_super_secure"
JWT_EXPIRES_IN="7d"
